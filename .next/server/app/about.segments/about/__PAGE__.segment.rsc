8:["$","section",null,{"className":"section-pad bg-ivory","children":["$","div",null,{"className":"max-w-screen-xl mx-auto px-6 lg:px-10","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center","children":[["$","$L3",null,{"children":[["$","span",null,{"className":"font-sans text-xs font-semibold tracking-[0.22em] uppercase text-teal block mb-4","children":"The Region"}],["$","span",null,{"className":"divider-champagne mb-6"}],["$","h2",null,{"className":"font-serif text-3xl md:text-4xl text-navy leading-tight mb-5","children":"Cape Breton Island, Nova Scotia"}],["$","div",null,{"className":"space-y-4 font-sans text-base text-muted leading-relaxed","children":[["$","p",null,{"children":"Cape Breton is an island of extraordinary contrasts — rugged Atlantic cliffs rising from deep sea, highland plateaus sweeping down to sheltered inlets, and the vast Bras d'Or Lake sitting like an inland ocean at the island's heart."}],["$","p",null,{"children":"The Cabot Trail — one of the most celebrated coastal drives in the world — circles the island's northern reaches through Cape Breton Highlands National Park. To the south, the Fortress of Louisbourg stands as one of North America's great living history sites. Baddeck, on the shores of the Bras d'Or, was home to Alexander Graham Bell and retains a civilised, unhurried character that draws visitors back year after year."}],["$","p",null,{"children":"This is the landscape we work within every day. We know its seasons, its light, its hidden viewpoints, and its stories. We are ready to share all of it with you."}]]}],["$","div",null,{"className":"mt-8 flex gap-4 flex-wrap","children":[["$","$L15",null,{"href":"/tours","className":"btn-outline-navy inline-flex","children":"Explore Tours"}],["$","$L15",null,{"href":"/contact","className":"btn-primary","children":"Plan Your Trip"}]]}]]}],["$","$L3",null,{"delay":100,"children":["$","div",null,{"className":"grid grid-cols-2 gap-3","childr