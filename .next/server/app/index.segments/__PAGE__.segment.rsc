d:["$","section",null,{"className":"section-pad bg-navy-deep overflow-hidden","aria-label":"Cape Breton editorial feature","children":["$","div",null,{"className":"max-w-screen-xl mx-auto px-6 lg:px-10","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center","children":[["$","$L4",null,{"children":["$","div",null,{"className":"flex flex-col gap-5","children":[["$","span",null,{"className":"font-sans text-xs font-semibold tracking-[0.22em] uppercase text-champagne","children":"The Cape Breton Experience"}],["$","span",null,{"className":"divider-champagne"}],["$","h2",null,{"className":"font-serif text-4xl md:text-5xl text-white leading-tight","children":"A Land That Stays With You Long After You Leave"}],["$","div",null,{"className":"prose-luxury","children":[["$","p",null,{"className":"text-white/70 font-sans text-base md:text-lg leading-relaxed","children":"Cape Breton Island is one of Canada's most extraordinary destinations — a place where the Atlantic crashes against cliffs of ancient granite, where highland plateaus meet inland seas, and where the lilting sounds of Gaelic music drift from open windows on summer evenings."}],["$","p",null,{"className":"text-white/70 font-sans text-base md:text-lg leading-relaxed mt-4","children":"The Cabot Trail traces 298 kilometres of some of the most celebrated coastal scenery in North America. Beyond it, the Bras d'Or Lake — a vast inland sea designated a UNESCO Biosphere Reserve — mirrors the sky in extraordinary silence. Fortress of Louisbourg transports visitors to 18th-century New France. Baddeck holds the legacy of Alexander Graham Bell."}],["$","p",null,{"className":"text-white/70 font-sans text-base md:text-lg leading-relaxed mt-4","children":"We are here to show you all of it — privately, at your pace, with the knowledge and care that makes the difference between a good trip and an unforgettable one."}]]}],["$","div",null,{"className":"flex gap-4 mt-2 flex-wrap","childr