# Public Formspree form ID from https://formspree.io/ (Integration → form endpoint).
# This is safe in the frontend. Do not put Formspree account passwords or API keys here.
# Example: mgaoaarq (from https://formspree.io/f/mgaoaarq)
VITE_FORMSPREE_FORM_ID=

# Optional: Google Analytics 4 measurement ID (also set as GA_MEASUREMENT_ID in GitHub Actions).
VITE_GA_ID=
